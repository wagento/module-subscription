/** @var \Magento\Framework\Escaper $escaper */

?>
<?php $_order = $block->getOrder(); ?>
<?php $subProductId = $_order->getSubProductId(); ?>
<?php if ($_order) { ?>
    <?php $_items = $_order->getAllItems(); ?>
    <table class="email-items">
        <thead>
        <tr>
            <th class="item-info">
                <?= $ecaper->escapeHtml('Items'); ?>
            </th>
            <th class="item-qty">
                <?= $ecaper->escapeHtml('Qty'); ?>
            </th>
            <th class="item-price">
                <?= $ecaper->escapeHtml('Price'); ?>
            </th>
        </tr>
        </thead>
        <?php foreach ($_items as $_item) { ?>
            <?php
            $productId = $_item->getProductId();
            if ($subProductId == $productId) {
                ?>
                <?php if (!$_item->getParentItem()) { ?>
                    <tbody>
                    <?= /* @noEscape */ $block->getItemHtml($_item); ?>
                    </tbody>
                <?php } ?>
            <?php
            } ?>
        <?php } ?>
        <tfoot class="order-totals">
        </tfoot>
    </table>
    <?php if ($this->helper('Magento\GiftMessage\Helper\Message')->isMessagesAllowed('order', $_order, $_order->getStore()) && $_order->getGiftMessageId()) { ?>
        <?php $_giftMessage = $this->helper('Magento\GiftMessage\Helper\Message')->getGiftMessage($_order->getGiftMessageId()); ?>
        <?php if ($_giftMessage) { ?>
            <br />
            <table class="message-gift">
                <tr>
                    <td>
                        <h3><?= $ecaper->escapeHtml('Gift Message for this Order'); ?></h3>
                        <strong><?= $ecaper->escapeHtml('From:'); ?></strong> <?= $escaper->escapeHtml($_giftMessage->getSender()); ?>
                        <br /><strong><?= $ecaper->escapeHtml('To:'); ?></strong> <?= $escaper->escapeHtml($_giftMessage->getRecipient()); ?>
                        <br /><strong><?= $ecaper->escapeHtml('Message:'); ?></strong>
                        <br /><?= $escaper->escapeHtml($_giftMessage->getMessage()); ?>
                    </td>
                </tr>
            </table>
        <?php } ?>
    <?php } ?>
<?php } ?>
